# VITE_ 로 시작하는 이름만 프론트엔드(브라우저)에서 읽을 수 있습니다.
VITE_GEMINI_API_KEY=여기에_발급받은_키를_넣으세요

# Supabase (프로젝트: saju-me / https://elgxjtyeuiraahtufszb.supabase.co)
# Dashboard → Project Settings → API 에서 확인하거나, MCP get_project_url / get_publishable_keys 로 조회
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=여기에_anon_또는_publishable_키를_넣으세요

# Google 로그인 사용 시 Dashboard에서 확인할 것
# Authentication → Providers → Google: Client ID / Secret 입력 후 Enable
# Authentication → URL Configuration:
#   Site URL = http://localhost:5173  (배포 시에는 배포 URL)
#   Redirect URLs 에 http://localhost:5173/** 추가
# Google Cloud Console → 클라이언트:
#   Authorized JavaScript origins = http://localhost:5173
#   Authorized redirect URIs = https://elgxjtyeuiraahtufszb.supabase.co/auth/v1/callback
